# GlassOps Configuration
GLASSOPS_PORT=7440
# Published web address. Keep loopback for local access or a TLS reverse proxy on
# this host. Remote agents can connect through that proxy at wss://.../ws/agent;
# they do not need direct access to port 7440. A LAN bind requires network controls.
# GLASSOPS_BIND=127.0.0.1
# REQUIRED in production. Generate a strong one: openssl rand -hex 32
# Leave empty to auto-generate & persist one at <data>/secret.key on first run.
# Weak/placeholder values (e.g. "change-me") are REJECTED at startup.
GLASSOPS_SECRET_KEY=
GLASSOPS_ADMIN_EMAIL=admin@glassops.local
# GLASSOPS_ADMIN_PASSWORD=     # If unset, a random one-time password is written to <data>/initial_admin_password (0600); forced change on first login
GLASSOPS_DB_PATH=/app/data/glassops.db

# Built-in agent (remote agents use agent.env instead)
# Keep the default local ID. GLASSOPS_AGENT_ID is overwritten by the entrypoint.
# GLASSOPS_LOCAL_AGENT_ID=local
# GLASSOPS_AGENT_KEY is auto-derived from SECRET_KEY for the built-in agent (do not set here).
# For REMOTE agents, set it to the backend's derived agent key:
#   docker compose exec glassops python -m app.secret_bootstrap agent
GLASSOPS_COLLECT_INTERVAL=1
# Dashboard GPU monitoring: make up-gpu grants device access and sets this default true.
# A GPU choice saved in Settings takes precedence. This flag alone does not expose GPUs.
GLASSOPS_ENABLE_GPU=false
GLASSOPS_ENABLE_DOCKER=true
# ENABLE_DOCKER populates Docker's Containers tab; off leaves the app visible but
# its container list empty. This flag does not revoke Docker API permissions.
# Standard deployments: recreate with make up (or make up-gpu) after env changes.
# With extra Compose files (e.g. socket proxy), use the same complete file list
# for docker compose up -d --build; see README's Keeping deployment options.
# Settings > Server: saved GPU/Docker/interval values override these defaults for
# the built-in agent and apply without restart. Saved intervals accept 1-60 seconds.
# Remote agents keep their agent.env settings. Review existing saved values on upgrade.

# Local terminal fallback — Users host mappings take priority, then the saved
# Settings > Server Terminal User, then this default if nothing has been saved.
# Saving an empty user clears the fallback for new sessions. No fallback/mapping
# means refusal unless you opt into a host login prompt (below).
# GLASSOPS_TERMINAL_USER=ubuntu
# Allow a host `login` prompt when no terminal user is configured. This lets a
# dashboard admin authenticate as ANY host account (incl. root) — off by default.
# Set true to keep the legacy login-prompt behavior.
# GLASSOPS_ALLOW_LOGIN_PROMPT=false

# Initial IP whitelist (comma-separated, empty = allow all). Change here and recreate.
# Settings > Server saves an IP draft; only Apply IP Rules + confirmation activates it.
# Confirmed rules override this default across restarts/recreation. Legacy drafts
# never activate automatically. IP Apply ends web terminals and reconnects agents;
# include remote agent addresses. See README for host-side recovery to this default.
# GLASSOPS_ALLOWED_IPS=192.168.1.0/24,10.0.0.5

# Reverse proxies whose forwarded headers are trusted (CIDR list). Drives BOTH the
# backend (X-Real-IP / X-Forwarded-Proto) AND nginx real_ip (X-Forwarded-For), so the
# IP whitelist + per-IP rate limits/lockouts see the true client behind an upstream
# LB/TLS proxy. The backend trusts bundled nginx on loopback; the edge nginx needs
# the direct proxy peer's non-loopback CIDR as seen by the container (possibly the
# Docker bridge gateway for a same-host proxy) to restore X-Forwarded-For.
# GLASSOPS_TRUSTED_PROXIES=10.0.0.0/24
# Set true for HTTPS through an upstream TLS proxy (the bundled edge uses HTTP).
# GLASSOPS_FORCE_SECURE_COOKIES=false
# Browser origins trusted for the WebSocket CSWSH guard AND the HTTP CSRF check on
# state-changing requests (POST/PUT/DELETE/PATCH). Comma-separated hostnames/URLs,
# e.g. https://ops.lan,http://10.0.0.9:7440. Only hostnames are compared; scheme and
# port are ignored. Empty = match the request Host hostname. A configured list
# replaces that fallback. Distinct from GLASSOPS_CORS_ORIGINS (CORS response headers).
# GLASSOPS_ALLOWED_ORIGINS=
# Origins echoed in CORS response headers for a split frontend/backend deployment
# (comma-separated). Default http://localhost:3000,http://localhost:3300. Not needed when
# the SPA is same-origin behind the bundled nginx. "*" entries are ignored.
# GLASSOPS_CORS_ORIGINS=
# Restrict which SMTP relay hosts the alert config may use (comma-separated hostnames/IPs).
# Empty = any host that passes SSRF checks (loopback/link-local/metadata blocked, RFC1918 allowed).
# GLASSOPS_SMTP_ALLOWED_HOSTS=

# Network connection audit (metadata only; admin-only, audit-logged). Off by default.
# GLASSOPS_ENABLE_NET_AUDIT=false
# GLASSOPS_NET_AUDIT_MAX_EVENTS=200
# GLASSOPS_NET_AUDIT_TOP_TALKERS=20
# GLASSOPS_NET_AUDIT_EVENT_DAYS=7
# GLASSOPS_NET_AUDIT_ROLLUP_DAYS=30
