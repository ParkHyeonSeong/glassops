# Replace with a unique host ID: 1-64 letters, digits, underscores or hyphens.
# Reserve "local" (or the dashboard's custom local ID) for the built-in agent.
GLASSOPS_AGENT_ID=change-me
# Backend's derived agent key (NOT the SECRET_KEY). On the dashboard host run:
#   docker compose exec glassops python -m app.secret_bootstrap agent
GLASSOPS_AGENT_KEY=change-me
# Use wss:// (TLS) for remote agents — plaintext ws:// exposes the agent key and
# all RPC traffic (shell/exec) to the network. ws:// is only safe for a loopback agent.
GLASSOPS_SERVER_URL=wss://dashboard.example.com/ws/agent
# For a private CA, mount its bundle read-only into this container, then use the
# CONTAINER path below (verification stays on). See README's private CA example.
# GLASSOPS_AGENT_CA=/etc/glassops/ca.pem
# Set true to refuse plaintext remote connections; default false only warns.
# GLASSOPS_REQUIRE_AGENT_TLS=true
GLASSOPS_COLLECT_INTERVAL=1
GLASSOPS_ENABLE_DOCKER=true
# On NVIDIA hosts, set true AND use make agent-up-gpu to grant device access.
# The dashboard Settings GPU switch controls only its own built-in agent.
GLASSOPS_ENABLE_GPU=false
# Standard deployments: recreate with make agent-up or make agent-up-gpu after edits.
# With extra files (e.g. private CA), use the same full -f list for
# docker compose up -d --build instead; the Make targets omit custom overlays.
# Remote terminals require an admin's host account mapping in the Users app.
# GLASSOPS_TERMINAL_USER / GLASSOPS_ALLOW_LOGIN_PROMPT fallback is local-only.

# Network connection audit (metadata only; admin-only). Off by default.
# GLASSOPS_ENABLE_NET_AUDIT=false
# GLASSOPS_NET_AUDIT_MAX_EVENTS=200
# GLASSOPS_NET_AUDIT_TOP_TALKERS=20
